      m_Calls: []
  m_text: "\u041A\u0430\u0440\u0442\u0430 \xAB\u0421\u043B\u0438\u043D\u044F\u0439\xBB
    \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u0435\u0442 \u0447\u0438\u0441\u043B\u043E
    \u0445\u043E\u0434\u043E\u0432 \u043D\u0430 1. \u0415\u0441\u043B\u0438 \u043D\u0430
    \u0442\u0435\u0431\u044F \u0441\u044B\u0433\u0440\u0430\u043B\u0438 \u043A\u0430\u0440\u0442\u0443
    \xAB\u041D\u0430\u043F\u0430\u0434\u0430\u0439\xBB, \u0442\u043E \u0442\u0435\u0431\u0435
    \u043D\u0443\u0436\u043D\u043E \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u0442\u044C
    \u0434\u0432\u0430 \u0445\u043E\u0434\u0430, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
    \u043F\u043E\u0441\u043B\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F
    \xAB\u0421\u043B\u0438\u043D\u044F\u0439\xBB \u0442\u0435\u0431\u0435 \u0432\u0441\u0435
    \u0440\u0430\u0432\u043D\u043E \u043D\u0430\u0434\u043E \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u0442\u044C
    \u0435\u0449\u0451 \u043E\u0434\u0438\u043D \u0445\u043E\u0434!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9f91887ca83a1984d936a357f0f3a245, type: 2}
