  m_text: "\u041A\u0430\u0440\u0442\u0430 \xAB\u0412\u0437\u0440\u044B\u0432\u043D\u043E\u0439
    \u043A\u043E\u0442\u0435\u043D\u043E\u043A\xBB \u2013 \u0441\u0430\u043C\u0430\u044F
    \u043E\u043F\u0430\u0441\u043D\u0430\u044F \u0432 \u0438\u0433\u0440\u0435. \u0415\u0441\u043B\u0438
    \u0432\u0437\u044F\u0442\u044C \u0435\u0435 \u0432 \u043A\u043E\u043B\u043E\u0434\u0443
    \u0438\u0433\u0440\u043E\u043A \u0432\u0437\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F!
    \u0421\u043F\u0430\u0441\u0442\u0438 \u043E\u0442 \u043D\u0435\u0435 \u043C\u043E\u0436\u0435\u0442
    \u0442\u043E\u043B\u044C\u043A\u043E \u043A\u0430\u0440\u0442\u0430 \xAB\u041E\u0431\u0435\u0437\u0432\u0440\u0435\u0434\u044C\xBB
    (\u043A\u0430\u0440\u0442\u0430 \xAB\u041D\u0435\u0442\u044C\xBB \u043D\u0435
    \u043C\u043E\u0436\u0435\u0442). \u0415\u0441\u043B\u0438 \u0438\u0433\u0440\u043E\u043A\u0443
    \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043F\u0435\u0440\u0435\u0436\u0438\u0442\u044C
    \xAB\u0412\u0437\u0440\u044B\u0432\u043D\u043E\u0433\u043E \u043A\u043E\u0442\u0435\u043D\u043A\u0430\xBB,
    \u043A\u0430\u0440\u0442\u0430 \u0437\u0430\u043C\u0435\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u043E\u0431\u0440\u0430\u0442\u043D\u043E \u0432 \u043A\u043E\u043B\u043E\u0434\u0443."
