  m_text: "\u041A\u0430\u0440\u0442\u0430 \xAB\u041E\u0431\u0435\u0437\u0432\u0440\u0435\u0434\u044C\xBB
    \u2013 \u044D\u0442\u043E \u0441\u0430\u043C\u0430\u044F \u043F\u043E\u043B\u0435\u0437\u043D\u0430\u044F
    (\u0438 \u0441\u0430\u043C\u0430\u044F \u0440\u0435\u0434\u043A\u0430\u044F)
    \u043A\u0430\u0440\u0442\u0430 \u0432 \u0438\u0433\u0440\u0435. \u0421\u043F\u0430\u0441\u0430\u0435\u0442
    \u0442\u0435\u0431\u044F \u043E\u0442 \xAB\u0412\u0437\u0440\u044B\u0432\u043D\u043E\u0433\u043E
    \u043A\u043E\u0442\u0435\u043D\u043A\u0430\xBB \u0436\u0435\u0440\u0442\u0432\u0443\u044F
    \u0441\u043E\u0431\u043E\u0439."
