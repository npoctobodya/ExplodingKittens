    \u043E\u0442\u043C\u0435\u043D\u0438\u0442\u044C \u044D\u0444\u0444\u0435\u043A\u0442
    \u043B\u044E\u0431\u043E\u0439 \u0441\u044B\u0433\u0440\u0430\u043D\u043D\u043E\u0439
    \u043A\u0430\u0440\u0442\u044B \u043D\u0430 \u0441\u0442\u043E\u043B\u0435, \u0434\u0430\u0436\u0435
    \u0441\u0432\u043E\u0435\u0439."
