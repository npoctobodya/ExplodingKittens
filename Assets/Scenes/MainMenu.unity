      m_Calls: []
  m_text: "\u041A\u0430\u0440\u0442\u044B \xAB\u0411\u043E\u0440\u043E\u0434\u043E\u043A\u043E\u0442\xBB,
    \xAB\u0412\u043E\u043B\u043E\u0441\u0430\u0442\u0430\u044F \u043A\u043E\u0448\u043A\u0430-\u043A\u0430\u0440\u0442\u043E\u0448\u043A\u0430\xBB,
    \xAB\u041A\u043E\u0448\u043A\u0430\u0440\u0431\u0443\u0437\xBB, \xAB\u0428\u0440\u0451\u0434\u0438\u043D\u0433\u0435\u0440
    \u043A\u043E\u0442\u0430\xBB, \xAB\u0422\u0430\u043A\u043E\u043A\u043E\u0442\xBB
    \u2013 \u044D\u0442\u043E \u043A\u043E\u0448\u043A\u043E\u043A\u0430\u0440\u0442\u044B.
    \u0422\u0435\u0431\u0435 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
    \u0445\u043E\u0442\u044F \u0431\u044B \u0434\u0432\u0435 \u043E\u0434\u043D\u043E\u0433\u043E
    \u0432\u0438\u0434\u0430, \u0447\u0442\u043E\u0431\u044B \u0440\u0430\u0437\u044B\u0433\u0440\u0430\u0442\u044C
    \u0438\u0445. \u041F\u0440\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438
    \u043E\u043D\u0438 \u043A\u0440\u0430\u0434\u0443\u0442 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u0443\u044E
    \u043A\u0430\u0440\u0442\u0443 \u0443 \u0438\u0433\u0440\u043E\u043A\u0430."
