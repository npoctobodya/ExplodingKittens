--- !u!114 &15260947
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 15260945}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041A\u0430\u0440\u0442\u0430 \xAB\u041D\u0430\u043F\u0430\u0434\u0430\u0439\xBB
    \u043E\u0442\u043D\u0438\u043C\u0430\u0435\u0442 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u0442\u0432\u043E\u0438\u0445 \u0445\u043E\u0434\u043E\u0432 \u043D\u0430 1,
    \u043F\u043E\u0441\u043B\u0435 \u044D\u0442\u043E\u0433\u043E \u043F\u0435\u0440\u0435\u0434\u0430\u0435\u0442
    \u0438\u0445 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C\u0443 \u0438\u0433\u0440\u043E\u043A\u0443,
    \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u044F \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    2 \u0445\u043E\u0434\u0430 \u0438 \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u0435\u0442
    \u0432\u0441\u0435 \u0442\u0432\u043E\u0438 \u0445\u043E\u0434\u044B. \u041F\u0440\u0438\u043C\u0435\u0440:
    \u0438\u0433\u0440\u043E\u043A\u0443 \u0410 \u043D\u0443\u0436\u043D\u043E \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u0442\u044C
    1 \u0445\u043E\u0434. \u041E\u043D \u0440\u0435\u0448\u0430\u0435\u0442 \u0441\u044B\u0433\u0440\u0430\u0442\u044C
    \u043A\u0430\u0440\u0442\u0443 \xAB\u041D\u0430\u043F\u0430\u0434\u0430\u0439\xBB
    \u043F\u0440\u043E\u0442\u0438\u0432 \u0438\u0433\u0440\u043E\u043A\u0430 \u0411,
    \u043F\u043E\u0441\u043B\u0435 \u0447\u0435\u0433\u043E \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u0435\u0433\u043E \u0445\u043E\u0434\u043E\u0432 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
    \u0440\u0430\u0432\u043D\u044B\u043C 1 - 1 = 0, \u0430 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u0445\u043E\u0434\u043E\u0432 \u0434\u043B\u044F \u0438\u0433\u0440\u043E\u043A\u0430
    \u0411 \u0440\u0430\u0432\u043D\u043E 0 + 2 = 2. \u041F\u043E\u0441\u043B\u0435
    \u044D\u0442\u043E\u0433\u043E \u0438\u0433\u0440\u043E\u043A \u0411 \u0442\u043E\u0436\u0435
    \u0440\u0435\u0448\u0430\u0435\u0442 \u0441\u044B\u0433\u0440\u0430\u0442\u044C
    \u043A\u0430\u0440\u0442\u0443 \xAB\u041D\u0430\u043F\u0430\u0434\u0430\u0439\xBB.
    \u041A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u0435\u0433\u043E
    \u0445\u043E\u0434\u043E\u0432 \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 1: 2 \u2013 1 = 1 (\u043F\u0440\u0438 \u044D\u0442\u043E\u043C \u0438\u0433\u0440\u043E\u043A
    \u0411 \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u0435\u0442 \u0432\u0441\u0435
    \u0441\u0432\u043E\u0438 \u0445\u043E\u0434\u044B), \u0438 \u0442\u0435\u043F\u0435\u0440\u044C
    \u0438\u0433\u0440\u043E\u043A \u0410 \u0434\u043E\u043B\u0436\u0435\u043D \u0441\u0434\u0435\u043B\u0430\u0442\u044C
    1 + 2 = 3 \u0445\u043E\u0434\u0430 \u043F\u043E\u0434\u0440\u044F\u0434."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9f91887ca83a1984d936a357f0f3a245, type: 2}
