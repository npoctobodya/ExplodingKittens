--- !u!114 &119487388
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 119487386}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u043C\u044B\u0448\u044C\u044E \u0438\u043B\u0438 \u043A\u0430\u0441\u0430\u043D\u0438\u0435\u043C
    \u043F\u043E \u044D\u043A\u0440\u0430\u043D\u0443: \u043A\u043B\u0438\u043A \u043F\u043E
    \u043A\u0430\u0440\u0442\u0435 \u0432 \u0440\u0443\u043A\u0435 \u2013 \u0432\u044B\u0431\u043E\u0440
    \u0434\u043B\u044F \u0440\u043E\u0437\u044B\u0433\u0440\u044B\u0448\u0430, \u0432\u0442\u043E\u0440\u043E\u0439
    \u043A\u043B\u0438\u043A - \u0440\u0430\u0437\u044B\u0433\u0440\u044B\u0432\u0430\u043D\u0438\u0435
    \u043A\u0430\u0440\u0442\u044B. \u043A\u043B\u0438\u043A \u043F\u043E \u043A\u043E\u043B\u043E\u0434\u0435
    \u2013 \u0432\u0437\u044F\u0442\u0438\u0435 \u043A\u0430\u0440\u0442\u044B.\n\n\u0415\u0441\u043B\u0438
    \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u043E\u0442\u0434\u0430\u0442\u044C
    \u043A\u0430\u0440\u0442\u0443, \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
    \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0435
    \u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F! \u041A\u0430\u0440\u0442\u0430
    \u043E\u0442\u0434\u0430\u0435\u0442\u0441\u044F \u043F\u0440\u0438 \u043F\u0435\u0440\u0432\u043E\u043C
    \u043D\u0430\u0436\u0430\u0442\u0438\u0438!\n\r\n\u041E\u0447\u0435\u0440\u0435\u0434\u043D\u043E\u0441\u0442\u044C
    \u0432 \u043D\u0430\u0447\u0430\u043B\u0435 \u0438\u0433\u0440\u044B \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442\u0441\u044F
    \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u043C \u043E\u0431\u0440\u0430\u0437\u043E\u043C.
    \u0417\u0430\u0442\u0435\u043C \u0438\u0433\u0440\u043E\u043A\u0438 \u0445\u043E\u0434\u044F\u0442
    \u043F\u043E \u0447\u0430\u0441\u043E\u0432\u043E\u0439 \u0441\u0442\u0440\u0435\u043B\u043A\u0435.
    \u0410\u0442\u0430\u043A\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
    \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u043F\u043E \u043E\u0447\u0435\u0440\u0435\u0434\u0438
    \u0438\u0433\u0440\u043E\u043A.\n\r\n\u0412\u043E \u0432\u0440\u0435\u043C\u044F
    \u0445\u043E\u0434\u0430 \u0438\u0433\u0440\u043E\u043A\u0430 \u043E\u043D \u043C\u043E\u0436\u0435\u0442
    \u0438\u0433\u0440\u0430\u0442\u044C \u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0443\u0433\u043E\u0434\u043D\u043E \u043A\u0430\u0440\u0442. \u0417\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0435\u043C
    \u0445\u043E\u0434\u0430 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
    \u0432\u0437\u044F\u0442\u0438\u0435 \u043A\u0430\u0440\u0442\u044B \u0438\u0437
    \u043A\u043E\u043B\u043E\u0434\u044B. \u0415\u0441\u043B\u0438 \u0431\u043E\u043B\u0435\u0435
    \u043F\u0440\u043E\u0441\u0442\u044B\u043C\u0438 \u0441\u043B\u043E\u0432\u0430\u043C\u0438:
    1 \u0445\u043E\u0434 = 1 \u0432\u0437\u044F\u0442\u0430\u044F \u043A\u0430\u0440\u0442\u0430
    \u0438\u0437 \u043A\u043E\u043B\u043E\u0434\u044B.\r\n"
